{
  "version": 0,
  "enabled": true,
  "mode": "On",
  "blocking_pl": 1,
  "detection_pl": 2,
  "cve_rules": { "CVE-2026-64642": false, "CVE-2026-64645": false },
  "crs_exclusions": { "sqli_search": false },
  "tuning_rules": [],
